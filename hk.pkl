amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"

local fastChecks = new Mapping<String, Step> {
  ["lint"] {
    check = "bun run lint"
  }
  ["architecture"] {
    check = "bun run check:architecture"
  }
}

hooks {
  ["check"] {
    steps = fastChecks
  }
  ["pre-commit"] {
    steps {
      ["staged-lint"] {
        check = "bash scripts/local-feedback-loop.sh lint pre-commit"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["affected-lint"] {
        check = "bash scripts/local-feedback-loop.sh lint pre-push"
      }
      ["architecture"] {
        check = "bash scripts/local-feedback-loop.sh architecture pre-push"
      }
      ["affected-tests"] {
        check = "bash scripts/local-feedback-loop.sh affected-tests pre-push"
      }
    }
  }
}

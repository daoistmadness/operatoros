# Replace every required placeholder with synthetic-only values before install.
# Install as operatoros-runtime:1002:1002 with mode 0600. The storage-check
# command rejects placeholders, unset keys, wrong origins and insecure settings.
AUTH_COOKIE_SECRET=GENERATE_SYNTHETIC_RANDOM_SECRET_AT_INSTALL
BACKUP_ENCRYPTION_KEY=GENERATE_DISTINCT_SYNTHETIC_BASE64_32_BYTE_KEY_AT_INSTALL
BACKUP_ENCRYPTION_KEY_ID=operatoros-d1-synthetic
ALLOWED_ORIGINS=http://127.0.0.1:18188
COOKIE_SECURE=false
ENABLE_DESTRUCTIVE_OPERATIONS=false

[Unit]
Description=OperatorOS Elysia API

[Container]
Image=@OPERATOROS_API_IMAGE@
Pull=never
ContainerName=operatoros-api
PublishPort=127.0.0.1:8090:8090
Environment=HOST=0.0.0.0
Environment=PORT=8090
Environment=NODE_ENV=production
Environment=OPERATOROS_DATA_DIR=/var/lib/operatoros/data
EnvironmentFile=/etc/operatoros/api.env
Volume=/var/lib/operatoros/data:/var/lib/operatoros/data:rw
User=10000:10000
UserNS=keep-id:uid=10000,gid=10000
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
HealthCmd=/usr/local/bin/operatoros-api-healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=600
TimeoutStopSec=45

[Install]
WantedBy=default.target

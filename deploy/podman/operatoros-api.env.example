# Copy to a host-managed secret file; do not put real values in source control.
# Use separate randomly generated values for the cookie and backup keys.
AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BACKUP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BACKUP_ENCRYPTION_KEY_ID=operatoros-key-1
ALLOWED_ORIGINS=https://operatoros.example.invalid
COOKIE_SECURE=true
ENABLE_DESTRUCTIVE_OPERATIONS=false
# Set only after verifying the API's direct peer address through the proxy path.
# TRUSTED_PROXY_ADDRESSES=

# Copy only after mount identity and capacity are freshly verified.
# Set min_free_bytes from measured payload plus the approved reserve. The
# 5-GiB value is only the minimum floor, not an approved capacity calculation.
root = "/mnt/podman-data/operatoros-d1-synthetic"
expected_uid = 1002
storage_mountpoint = "/mnt/podman-data"
storage_uuid = "RECHECKED_FILESYSTEM_UUID_REQUIRED"
storage_fstype = "ext4"
storage_driver = "overlay"
storage_conf = "/mnt/podman-data/operatoros-d1-synthetic/deploy/storage.conf"
graphroot = "/mnt/podman-data/operatoros-d1-synthetic/podman-rootless/graphroot"
runroot = "/run/user/1002/operatoros-podman-runroot"
data_dir = "/mnt/podman-data/operatoros-d1-synthetic/data/sqlite"
backup_dir = "/mnt/podman-data/operatoros-d1-synthetic/data/sqlite/backups"
api_unit = "/home/operatoros-runtime/.config/containers/systemd/operatoros-lite-api.container"
api_unit_copy = "/mnt/podman-data/operatoros-d1-synthetic/deploy/operatoros-lite-api.container"
caddy_unit = "/home/operatoros-runtime/.config/containers/systemd/operatoros-lite-caddy.container"
api_service = "operatoros-lite-api.service"
caddy_service = "operatoros-lite-caddy.service"
api_url = "http://127.0.0.1:18190"
web_url = "http://127.0.0.1:18188"
min_free_bytes = 5368709120
min_free_inodes = 20000
backup_max_age_seconds = 86400
root_min_free_bytes = 16106127360

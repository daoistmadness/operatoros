# Backend
OPERATOROS_BACKEND=elysia
# Optional explicit local data root. The database, backups, and logs derive from it.
# Keep normal operator data outside the Git repository.
# OPERATOROS_DATA_DIR=/absolute/path/to/operatoros-data
# Deprecated compatibility alias. OPERATOROS_DATA_DIR takes precedence.
# OPERATOROS_DEV_DATA_DIR=/absolute/path/to/operatoros-data
# DATABASE_URL is for disposable or externally managed runs. Managed startup derives it from OPERATOROS_DATA_DIR.
DATABASE_URL=
HOST=127.0.0.1
PORT=8000
ENABLE_DESTRUCTIVE_OPERATIONS=false

# Persistent HMAC secret for opaque server-side sessions. Minimum 32 characters.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Copy .env.example to .env and store the generated value there. Never commit or print it.
AUTH_COOKIE_SECRET=
# Optional for direct loopback development; required by Docker/server setup.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Remove it from deployed secrets after the first administrator is provisioned.
ASTRYX_SETUP_TOKEN=
# false for localhost HTTP; true only when the browser uses HTTPS.
COOKIE_SECURE=false
# Sliding idle lifetime and hard absolute lifetime for database sessions.
SESSION_IDLE_TIMEOUT_HOURS=6
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
# Temporary lockout policy for consecutive failed logins.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
# Login abuse controls. Values use a 60-second sliding window by default.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_GLOBAL=100
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
# Forwarded client IP headers stay untrusted unless the direct peer is listed.
TRUSTED_PROXY_ADDRESSES=
# Exact browser origins. Do not use a wildcard with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base64 encoding of exactly 32 random bytes. Required for new backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=primary
# JSON object of key IDs to Base64 keys retained for old backups.
BACKUP_ENCRYPTION_PREVIOUS_KEYS=
# Legacy plaintext restore is refused unless this is explicitly true.
ALLOW_LEGACY_PLAINTEXT_BACKUPS=false
# Must match the actual Uvicorn worker count. Restore fails closed above one.
BACKEND_WORKERS=1
# Keep true until an approved cross-process restore lock exists.
RESTORE_SINGLE_WORKER_REQUIRED=true

# Frontend API base URL
# Leave empty to use the Vite development proxy (recommended for local development).
# The Vite proxy forwards /api/* from http://localhost:5173 to the selected backend on port 8000.
VITE_API_BASE_URL=

# Set this for standalone deployments where the frontend is served separately from the backend.
# Example: VITE_API_BASE_URL=http://127.0.0.1:8000

# Runtime injection — set dynamically at runtime if present, not here.
# window.__APP_CONFIG__ = { apiBaseUrl: "http://127.0.0.1:<dynamic-port>" }

# Development server address overrides
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Docker Compose database settings
POSTGRES_USER=postgres
# Required by Compose. Set a non-example value in the gitignored .env file.
POSTGRES_PASSWORD=
POSTGRES_DB=absensi
POSTGRES_HOST=db
POSTGRES_PORT=5432

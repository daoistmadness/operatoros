# Backend
# Node environment label: development (default), test, or production.
# NODE_ENV=production
# Optional explicit local data root. The database, backups, and logs derive from it.
# Keep normal operator data outside the Git repository.
# OPERATOROS_DATA_DIR=/absolute/path/to/operatoros-data
# Repository root used for repository-scoped default data paths. Set by ./start-dev.sh;
# not needed when OPERATOROS_DATA_DIR is explicit.
# OPERATOROS_REPOSITORY_ROOT=/absolute/path/to/operatoros
# Deprecated compatibility alias. OPERATOROS_DATA_DIR takes precedence.
# OPERATOROS_DEV_DATA_DIR=/absolute/path/to/operatoros-data
# Managed-development flag set by ./start-dev.sh. Leave unset in deployments.
# OPERATOROS_MANAGED_DEV_SETUP=true
# DATABASE_URL is for disposable or externally managed runs. Managed startup derives it from OPERATOROS_DATA_DIR.
DATABASE_URL=
# Fallback SQLite path when DATABASE_URL is unset. With OPERATOROS_DATA_DIR set it must
# resolve to that root's operatoros.sqlite or startup fails.
# DATABASE_PATH=/absolute/path/to/operatoros.sqlite
HOST=127.0.0.1
# Direct API default. ./start-dev.sh overrides this from BACKEND_PORT.
PORT=8090
ENABLE_DESTRUCTIVE_OPERATIONS=false

# Persistent HMAC secret for opaque server-side sessions. Minimum 32 characters.
# Generate once with: bun -e 'console.log(require("node:crypto").randomBytes(48).toString("base64url"))'
# Copy .env.example to .env and store the generated value there. Never commit or print it.
AUTH_COOKIE_SECRET=
# Optional; when configured, first-run setup requires the matching token.
# Generate once with: bun -e 'console.log(require("node:crypto").randomBytes(48).toString("base64url"))'
# Remove it from deployed secrets after the first administrator is provisioned.
ASTRYX_SETUP_TOKEN=
# false for localhost HTTP; true only when the browser uses HTTPS.
COOKIE_SECURE=false
# Defaults are 6h/24h/5 attempts/30m; these optional variables override them.
# All values must be positive integers. Idle timeout must not exceed absolute timeout.
# SESSION_IDLE_TIMEOUT_HOURS=6
# SESSION_ABSOLUTE_TIMEOUT_HOURS=24
# MAX_FAILED_LOGIN_ATTEMPTS=5
# ACCOUNT_LOCK_MINUTES=30
# Login abuse controls. Values use a 60-second sliding window by default.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_GLOBAL=100
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
# Forwarded client IP headers stay untrusted unless the direct peer is listed.
TRUSTED_PROXY_ADDRESSES=
# Exact browser origins. Do not use a wildcard with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base64 encoding of exactly 32 random bytes. Required for new backups and
# must differ from AUTH_COOKIE_SECRET.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=primary
# JSON object of key IDs to Base64 keys retained for old backups.
BACKUP_ENCRYPTION_PREVIOUS_KEYS=
# Optional consistency assertion only. When set it must equal <data root>/backups.
# BACKUP_DIR=/absolute/path/to/operatoros-data/backups
# Legacy plaintext restore is refused unless this is explicitly true.
ALLOW_LEGACY_PLAINTEXT_BACKUPS=false
# Operator declarations only. No application code reads these variables.
# Keep one API process per SQLite data root: backup, restore, and scheduler
# guards are process-local (see docs/runbooks/backup-restore.md).
BACKEND_WORKERS=1
RESTORE_SINGLE_WORKER_REQUIRED=true

# Frontend API base URL
# Leave empty to use the Vite development proxy (recommended for local development).
# The Vite proxy forwards /api/* from http://localhost:5173 to the selected backend
# (the launcher defaults to 8000; a direct API run defaults to 8090).
VITE_API_BASE_URL=

# Set this for standalone deployments where the frontend is served separately from the backend.
# Example: VITE_API_BASE_URL=http://127.0.0.1:8000

# Runtime injection — set dynamically at runtime if present, not here.
# window.__APP_CONFIG__ = { apiBaseUrl: "http://127.0.0.1:<dynamic-port>" }

# Development server address overrides
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

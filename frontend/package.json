{
  "name": "@operatoros/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.4.0 <2"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-table": "8.21.3",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.471.2",
    "react": "19.2.4",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.4",
    "react-router-dom": "7.15.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/cli": "4.2.2",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "happy-dom": "20.10.6",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.10",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "api:check": "bun ../scripts/openapi-contracts.mjs check",
    "api:generate": "bun ../scripts/openapi-contracts.mjs generate",
    "boundaries:check": "bun ../scripts/frontend-boundaries.mjs",
    "boundaries:test": "bun test ../scripts/frontend-boundaries.test.mjs",
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "typecheck": "bun run --bun tsc --noEmit",
    "test:e2e": "bun run --bun playwright test",
    "e2e:release": "bun run --bun playwright test --config playwright.config.ts --grep @release",
    "preview": "bun run --bun vite preview",
    "test": "bun run --bun vitest run",
    "check:dependencies": "bun dedupe --check",
    "check:node-regressions": "bun ../scripts/check-node-regressions.mjs",
    "check:audit": "bun audit"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

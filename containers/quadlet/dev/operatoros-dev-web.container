[Unit]
Description=OperatorOS development Vite server
Requires=operatoros-dev.service operatoros-dev-pod.service
After=operatoros-dev.service operatoros-dev-pod.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Container]
ContainerName=operatoros-dev-web
Image=operatoros-dev.build
Pod=operatoros-dev.pod
StartWithPod=false
Volume=%h/code/repos/operatoros:/workspace/operatoros:ro
Volume=operatoros-dev-node-modules.volume:/workspace/operatoros/node_modules:U
Environment=FRONTEND_HOST=0.0.0.0
Environment=FRONTEND_PORT=5173
Environment=BACKEND_PORT=8090
Environment=DEV_API_PROXY_TARGET=http://127.0.0.1:8090
Environment=OPERATOROS_DISABLE_ENV_FILES=true
Environment=VITE_HMR_HOST=oprserver.taile856.ts.net
Environment=VITE_HMR_PROTOCOL=wss
Environment=VITE_HMR_CLIENT_PORT=8444
Exec=/usr/local/bin/operatoros-dev-entrypoint web
HealthCmd=/usr/local/bin/operatoros-dev-healthcheck web
HealthInterval=10s
HealthTimeout=3s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill
Notify=healthy
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s

[Install]
WantedBy=default.target

ARG BUN_IMAGE=docker.io/oven/bun@sha256:296a79bbc988bb0a91ef11099af70a78a8cba98b73fd53f7b2a7715b7c86ced2
ARG BUN_RUNTIME_IMAGE=docker.io/oven/bun@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f

FROM ${BUN_IMAGE} AS dependencies
WORKDIR /workspace
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/excel/package.json packages/excel/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN bun install --frozen-lockfile
COPY . .

FROM ${BUN_RUNTIME_IMAGE} AS api-runtime-dependencies
WORKDIR /workspace
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/excel/package.json packages/excel/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN bun install --frozen-lockfile --production --filter '@operatoros/api...' \
    && apk add --no-cache libcrypto3=3.5.9-r0 libssl3=3.5.9-r0 \
    && rm -rf /root/.bun/install/cache

FROM api-runtime-dependencies AS api
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/daoistmadness/operatoros" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.title="OperatorOS API"
COPY --from=dependencies /workspace/apps/api/src ./apps/api/src
COPY --from=dependencies /workspace/openapi/operatoros.openapi.json ./openapi/operatoros.openapi.json
COPY --from=dependencies /workspace/packages/contracts/src ./packages/contracts/src
COPY --from=dependencies /workspace/packages/db/src ./packages/db/src
COPY --from=dependencies /workspace/packages/excel/src ./packages/excel/src
COPY containers/api-healthcheck.sh /usr/local/bin/operatoros-healthcheck
RUN chmod 0555 /usr/local/bin/operatoros-healthcheck
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8090
USER bun
EXPOSE 8090
CMD ["bun", "run", "apps/api/src/server.ts"]

FROM dependencies AS web-build
RUN bun --filter @operatoros/web build

FROM docker.io/nginxinc/nginx-unprivileged@sha256:56b8272e43a0525f67aed68d1e0794a712d10e3e45a563e118e9a77c817e6f86 AS web
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/daoistmadness/operatoros" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.title="OperatorOS web"
COPY containers/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build --chown=101:101 /workspace/apps/web/build /usr/share/nginx/html
EXPOSE 8080

FROM dependencies AS development
WORKDIR /workspace/operatoros
ENV NODE_ENV=development
COPY --chown=bun:bun containers/dev-entrypoint.sh /usr/local/bin/operatoros-dev-entrypoint
COPY --chown=bun:bun containers/dev-healthcheck.sh /usr/local/bin/operatoros-dev-healthcheck
RUN chmod 0555 /usr/local/bin/operatoros-dev-entrypoint /usr/local/bin/operatoros-dev-healthcheck
USER bun
CMD ["bun", "--version"]

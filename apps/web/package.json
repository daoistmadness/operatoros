{
  "name": "@operatoros/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4 <2"
  },
  "dependencies": {
    "@operatoros/contracts": "workspace:*",
    "@operatoros/ui": "workspace:*",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@sinclair/typebox": "catalog:",
    "@tanstack/history": "1.162.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "9.3.1",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.471.2",
    "react": "19.2.7",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.7",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "26.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "scripts": {
    "api:check": "bun ../../scripts/openapi-contracts.mjs check",
    "api:generate": "bun ../../scripts/openapi-contracts.mjs generate",
    "boundaries:check": "bun ../../scripts/frontend-boundaries.mjs",
    "boundaries:test": "bun test ../../scripts/frontend-boundaries.test.mjs",
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "typecheck": "../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test:e2e": "bun run --bun playwright test",
    "e2e:release": "bun run --bun playwright test --config playwright.config.ts --grep @release",
    "preview": "bun run --bun vite preview",
    "test": "bun run --bun vitest run",
    "check:dependencies": "bun dedupe --check",
    "check:node-regressions": "bun ../../scripts/check-node-regressions.mjs",
    "check:audit": "bun audit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
